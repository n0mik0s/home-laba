---
# Copy to group_vars/ipaserver/secrets.sops.yaml and encrypt in place:
#   cp group_vars/ipaserver/secrets.sops.yaml.example group_vars/ipaserver/secrets.sops.yaml
#   # edit the CHANGE_ME placeholder with a long, random passphrase
#   # (e.g. `openssl rand -base64 32`), then:
#   sops -e -i group_vars/ipaserver/secrets.sops.yaml
#
# The encrypted file IS committed — that's the point of sops. Only the age
# private key (confidential/sops/age-keys.txt) must never be committed.
#
# Server-only secret. The realm-wide admin credential (ipaadmin_principal /
# ipaadmin_password — needed by both playbooks/install.yml and
# playbooks/enroll-client.yml) lives in group_vars/all/secrets.sops.yaml
# instead, since ipaclients hosts don't inherit group_vars/ipaserver/.

# Directory Manager (LDAP root DN) password — also needed for DR.
ipadm_password: "CHANGE_ME_use_a_long_random_passphrase"
