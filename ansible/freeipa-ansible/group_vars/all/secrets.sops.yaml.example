---
# Copy to group_vars/all/secrets.sops.yaml and encrypt in place:
#   cp group_vars/all/secrets.sops.yaml.example group_vars/all/secrets.sops.yaml
#   # edit the CHANGE_ME placeholder with a long, random passphrase
#   # (e.g. `openssl rand -base64 32`), then:
#   sops -e -i group_vars/all/secrets.sops.yaml
#
# The encrypted file IS committed — that's the point of sops. Only the age
# private key (confidential/sops/age-keys.txt) must never be committed.
#
# Realm-wide admin credential — group_vars/all/ so it's visible to both the
# ipaserver group (playbooks/install.yml, playbooks/manage-identity.yml) and
# the ipaclients group (playbooks/enroll-client.yml). The Directory Manager
# password (ipadm_password, server-only) lives in
# group_vars/ipaserver/secrets.sops.yaml instead.

ipaadmin_principal: admin

# IPA 'admin' Kerberos principal password.
ipaadmin_password: "CHANGE_ME_use_a_long_random_passphrase"
