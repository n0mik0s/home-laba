# === Terraform ===
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
.terraform.lock.hcl
crash.log
crash.*.log
*.tfplan
*.tfplan.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl and config.tfvars are committed intentionally (no secrets)

# === Local pinned CLI binaries (see scripts/bootstrap-bin.sh) ===
bin/

# === Python / uv ===
.venv/

# === Ansible ===
*.retry
# NOTE: *.sops.yaml files ARE committed intentionally — they are age-encrypted
# at rest, that's the point of sops. Only the age private key (kept under
# confidential/, see below) and any plaintext scratch files must stay local.

# === Secrets / credentials (defense in depth) ===
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*

# === Confidential data (recursive) ===
confidential/

# === Claude Code settings (recursive) ===
.claude/
CLAUDE.md

# === Editor / OS cruft ===
.DS_Store
*.swp
*.swo
*~
